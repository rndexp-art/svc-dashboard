# dashboard service env. Real values live in the gateway's .env / .env.production
# (and in GH Actions Secrets for production deploys). This file documents the
# required keys; it is not loaded directly.
#
# Phase 1 (current): no env vars are required — auth is enforced by Caddy
# `forward_auth` and the admin gate reads X-Auth-* headers from the request.
#
# Phase 2 (users CRUD against svc-auth):
#   AUTH_INTERNAL_BASE_URL=http://auth:8001
#
# Phase 3 (VPS + service monitoring via SSH):
#   DASHBOARD_VPS_SSH_KEY_PATH=/run/secrets/contabo_vps
#
# Phase 4 (project creation flow):
#   GITHUB_PAT=<reuse the PAT tools/rndexp uses>
